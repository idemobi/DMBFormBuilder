@using DMBBootstrapBuilder
@using DMBPageBuilder
@using DMBComponentBuilder
@using DMBFormBuilder
@model DMBFormBuilderLabs.Models.FormBuilderPasswordFieldExampleModel
@{
    Layout = "_Layout";
}

@using (Html.FlexBlockBuilder().SetJustifyContentBetween().SetAlignItemsCenter().WithWrap().WithGap(Old_Gap.Gap2).SetMargin(SpacingSide.Bottom, SpacingSize.Three).Begin())
{
    @Html.TitleBuilder().SetTitle("Password Fields", TitleLevel.One).Render()
    @Html.Button(ActionItemFactory.Url("PasswordFieldBuilder documentation", @Url.Action("Show", "Documentation", new { groupName = "NuGet", packageId = "DMBFormBuilder", version = "0.9", namespaceName = "DMBFormBuilder", objectName = "PasswordFieldBuilder" }), IconStruct.Bootstrap("bi-journal-code")).SetVariant(VariantStyle.Primary).SetOutlined()).Render()
}

@using (Html.PB_P().AsMuted().AddClass("mb-4").Begin())
{
    @:PasswordFieldBuilder renders password inputs with visibility toggle, required markers, validation feedback, browser autocomplete semantics, optional strength meter and confirmation validation.
}

@using (Html.FormBuilder()
    .SetAction(Url.Action("PasswordFields", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Password field examples")
    .Begin())
{
    @Html.AntiForgeryToken()

    @Html.TitleBuilder().SetTitle("Presentation Styles And Alerts", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B001Normal", "Normal label + field", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B002Floating", "Floating label", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B003Inline", "Inline label + field", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B004Hidden", "Hidden label", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B005Disabled", "Locked field", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B006DisabledReveal", "Locked field + reveal", model: Model)
        }
    }

    @Html.TitleBuilder().SetTitle("Strength Meter Presentations", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B006StrengthNormal", "Normal label + strength", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B007StrengthFloating", "Floating label + strength", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B008StrengthInline", "Inline label + strength", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B009StrengthHidden", "Hidden label + strength", model: Model)
        }
    }

    @Html.TitleBuilder().SetTitle("Password Rules", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/PasswordFields/_B010Confirm", "Confirmation validation", model: Model)
        }
    }

    <button class="btn btn-primary" type="submit">Submit</button>
}

@Html.TitleBuilder().SetTitle("Code Examples", TitleLevel.Three).Render()
@(Html.CodeBlock("@Html.PasswordFieldBuilderFor(m => m.CurrentPassword).Render()\n@Html.PasswordFieldBuilderFor(m => m.CurrentPassword).SetLabelPresentation(FormLabelPresentation.Floating).Render()\n@Html.PasswordFieldBuilderFor(m => m.CurrentPassword).SetLabelPresentation(FormLabelPresentation.Inline).Render()\n@Html.PasswordFieldBuilderFor(m => m.HiddenPassword).SetLabelPresentation(FormLabelPresentation.Hidden).Render()\n@Html.PasswordFieldBuilderFor(m => m.DisabledPassword).SetDisabled().SetToggle(false).Render()\n@Html.PasswordFieldBuilderFor(m => m.RevealLockedPassword).SetDisabled().SetToggle().Render()\n@Html.PasswordFieldBuilderWithStrengthFor(m => m.StrengthPasswordNormal).Render()\n@Html.PasswordFieldBuilderWithStrengthFor(m => m.StrengthPasswordFloating).SetLabelPresentation(FormLabelPresentation.Floating).Render()\n@Html.PasswordFieldBuilderWithStrengthFor(m => m.StrengthPasswordInline).SetLabelPresentation(FormLabelPresentation.Inline).Render()\n@Html.PasswordFieldBuilderWithStrengthFor(m => m.StrengthPasswordHidden).SetLabelPresentation(FormLabelPresentation.Hidden).Render()\n@Html.PasswordFieldBuilderWithStrengthFor(m => m.ConfirmPassword).SetLabelPresentation(FormLabelPresentation.Inline).Render()", CodeLanguage.CSharp)
    .SetTitle("PasswordFields.cshtml")
    .SetCopyButton()
    .Render())
