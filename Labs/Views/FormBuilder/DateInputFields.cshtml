@using DMBBootstrapBuilder
@using DMBPageBuilder
@using DMBComponentBuilder
@using DMBFormBuilder
@model DMBFormBuilderLabs.Models.FormBuilderDateInputExampleModel
@{
    Layout = "_Layout";
}

@using (Html.FlexBlockBuilder().SetJustifyContentBetween().SetAlignItemsCenter().WithWrap().WithGap(Old_Gap.Gap2).SetMargin(SpacingSide.Bottom, SpacingSize.Three).Begin())
{
    @Html.TitleBuilder().SetTitle("Date Input Fields", TitleLevel.One).Render()
    @Html.Button(ActionItemFactory.Url("InputSpecialFieldBuilderExtensions documentation", @Url.Action("Show", "Documentation", new { groupName = "NuGet", packageId = "DMBFormBuilder", version = "0.9", namespaceName = "DMBFormBuilder", objectName = "InputSpecialFieldBuilderExtensions" }), IconStruct.Bootstrap("bi-journal-code")).SetVariant(VariantStyle.Primary).SetOutlined()).Render()
}

@using (Html.PB_P().AsMuted().AddClass("mb-4").Begin())
{
    @:Date input helpers configure TextFieldBuilder for browser-native date controls while preserving labels, validation feedback and presentation modes.
}

@using (Html.FormBuilder()
    .SetAction(Url.Action("DateInputFields", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Date input field examples")
    .Begin())
{
    @Html.AntiForgeryToken()

    @Html.TitleBuilder().SetTitle("Presentation Styles And Alerts", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateInputFields/_B001Date", "Date", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateInputFields/_B002FloatingDate", "Floating date", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateInputFields/_B003InlineDate", "Inline date", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateInputFields/_B004HiddenDate", "Hidden label", model: Model)
        }
    }

    @Html.TitleBuilder().SetTitle("State Variants", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateInputFields/_B005DisabledDate", "Locked date", model: Model)
        }
    }

    <button class="btn btn-primary" type="submit">Submit</button>
}

@Html.TitleBuilder().SetTitle("Code Examples", TitleLevel.Three).Render()
@(Html.CodeBlock("@Html.DateFieldBuilderFor(m => m.DueDate).Render()\n@Html.DateFieldBuilderFor(m => m.FloatingDate).SetLabelPresentation(FormLabelPresentation.Floating).Render()\n@Html.DateFieldBuilderFor(m => m.InlineDate).SetLabelPresentation(FormLabelPresentation.Inline).Render()\n@Html.DateFieldBuilderFor(m => m.HiddenDate).SetLabelPresentation(FormLabelPresentation.Hidden).Render()\n@Html.DateFieldBuilderFor(m => m.DisabledDate).SetDisabled().Render()", CodeLanguage.CSharp)
    .SetTitle("DateInputFields.cshtml")
    .SetCopyButton()
    .Render())
