@model DMBFormBuilderLabs.Models.FormBuilderDateTimeInputExampleModel
@{
    Layout = "_Layout";
}

@using (Html.FlexBlockBuilder().SetJustifyContentBetween().SetAlignItemsCenter().WithWrap().WithGap(Old_Gap.Gap2).SetMargin(SpacingSide.Bottom, SpacingSize.Three).Begin())
{
    @Html.TitleBuilder().SetTitle("Date Time Input Fields", TitleLevel.One).Render()
    @Html.Button(ActionItemFactory.Url("InputSpecialFieldBuilderExtensions documentation", @Url.Action("Show", "Documentation", new { groupName = "NuGet", packageId = "DMBFormBuilder", version = "0.9", namespaceName = "DMBFormBuilder", objectName = "InputSpecialFieldBuilderExtensions" }), IconStruct.Bootstrap("bi-journal-code")).SetVariant(VariantStyle.Primary).SetOutlined()).Render()
}

@using (Html.PB_P().AsMuted().AddClass("mb-4").Begin())
{
    @:DateTimeFieldBuilderFor configures TextFieldBuilder as a datetime-local field, so the date and hour are edited together while keeping the same label presentation rules.
}

@using (Html.FormBuilder()
    .SetAction(Url.Action("DateTimeInputFields", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Date time input field examples")
    .Begin())
{
    @Html.AntiForgeryToken()

    @Html.TitleBuilder().SetTitle("Presentation Styles And Alerts", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateTimeInputFields/_B001DateTime", "Date and time", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateTimeInputFields/_B002FloatingDateTime", "Floating date and time", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateTimeInputFields/_B003InlineDateTime", "Inline date and time", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateTimeInputFields/_B004HiddenDateTime", "Hidden label", model: Model)
        }
    }

    @Html.TitleBuilder().SetTitle("State Variants", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/DateTimeInputFields/_B005DisabledDateTime", "Locked date and time", model: Model)
        }
    }

    <button class="btn btn-primary" type="submit">Submit</button>
}

@Html.TitleBuilder().SetTitle("Code Examples", TitleLevel.Three).Render()
@(Html.CodeBlock("@Html.DateTimeFieldBuilderFor(m => m.DueDateTime).Render()\n@Html.DateTimeFieldBuilderFor(m => m.FloatingDateTime).SetLabelPresentation(FormLabelPresentation.Floating).Render()\n@Html.DateTimeFieldBuilderFor(m => m.InlineDateTime).SetLabelPresentation(FormLabelPresentation.Inline).Render()\n@Html.DateTimeFieldBuilderFor(m => m.HiddenDateTime).SetLabelPresentation(FormLabelPresentation.Hidden).Render()\n@Html.DateTimeFieldBuilderFor(m => m.DisabledDateTime).SetDisabled().Render()", CodeLanguage.CSharp)
    .SetTitle("DateTimeInputFields.cshtml")
    .SetCopyButton()
    .Render())
