@using DMBBootstrapBuilder
@using DMBPageBuilder
@using DMBComponentBuilder
@using DMBFormBuilder
@model DMBFormBuilderLabs.Models.FormBuilderTimeInputExampleModel
@{
    Layout = "_Layout";
}

@using (Html.FlexBlockBuilder().SetJustifyContentBetween().SetAlignItemsCenter().WithWrap().WithGap(Old_Gap.Gap2).SetMargin(SpacingSide.Bottom, SpacingSize.Three).Begin())
{
    @Html.TitleBuilder().SetTitle("Time Input Fields", TitleLevel.One).Render()
    @Html.Button(ActionItemFactory.Url("InputSpecialFieldBuilderExtensions documentation", @Url.Action("Show", "Documentation", new { groupName = "NuGet", packageId = "DMBFormBuilder", version = "0.9", namespaceName = "DMBFormBuilder", objectName = "InputSpecialFieldBuilderExtensions" }), IconStruct.Bootstrap("bi-journal-code")).SetVariant(VariantStyle.Primary).SetOutlined()).Render()
}

@using (Html.PB_P().AsMuted().AddClass("mb-4").Begin())
{
    @:Time input helpers cover browser-native time and month controls while keeping FormBuilder label and validation behavior.
}

@using (Html.FormBuilder()
    .SetAction(Url.Action("TimeInputFields", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Time input field examples")
    .Begin())
{
    @Html.AntiForgeryToken()

    @Html.TitleBuilder().SetTitle("Time Controls", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/TimeInputFields/_B001Time", "Time", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/TimeInputFields/_B002Month", "Month", model: Model)
        }
    }

    @Html.TitleBuilder().SetTitle("Presentation And State", TitleLevel.Three).Render()
    @using (Html.RowBuilder().SetGap(Gap.G3).AddClass("mb-4").Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/TimeInputFields/_B003InlineTime", "Inline time", model: Model)
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Xl).Begin())
        {
            @await Html.RenderExamplePartialAsync("Examples/Form/TimeInputFields/_B004DisabledMonth", "Locked month", model: Model)
        }
    }

    <button class="btn btn-primary" type="submit">Submit</button>
}

@Html.TitleBuilder().SetTitle("Code Examples", TitleLevel.Three).Render()
@(Html.CodeBlock("@Html.TimeFieldBuilderFor(m => m.Time).Render()\n@Html.MonthFieldBuilderFor(m => m.Month).SetLabelPresentation(FormLabelPresentation.Floating).Render()\n@Html.TimeFieldBuilderFor(m => m.InlineTime).SetLabelPresentation(FormLabelPresentation.Inline).Render()\n@Html.MonthFieldBuilderFor(m => m.DisabledMonth).SetDisabled().Render()", CodeLanguage.CSharp)
    .SetTitle("TimeInputFields.cshtml")
    .SetCopyButton()
    .Render())
