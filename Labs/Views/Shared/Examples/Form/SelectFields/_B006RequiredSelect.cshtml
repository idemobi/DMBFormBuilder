@using DMBFormBuilder
@model DMBFormBuilderLabs.Models.FormBuilderSelectExampleModel

@(Html.SelectFieldBuilder()
    .SetInput(nameof(Model.RequiredPriority), nameof(Model.RequiredPriority))
    .SetLabel("Priority")
    .SetValue(Model.RequiredPriority)
    .SetRequired()
    .AddOption(string.Empty, "Choose a priority")
    .AddOption(nameof(DMBFormBuilderLabs.Models.FormBuilderSamplePriority.Low), "Low")
    .AddOption(nameof(DMBFormBuilderLabs.Models.FormBuilderSamplePriority.Medium), "Medium")
    .AddOption(nameof(DMBFormBuilderLabs.Models.FormBuilderSamplePriority.High), "High")
    .Render())
