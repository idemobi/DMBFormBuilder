@using DMBFormBuilder
@model DMBFormBuilderLabs.Models.FormBuilderFlagExampleModel

@(Html.FlagFieldBuilder()
    .SetInput("ManualPermissions", "ManualPermissions")
    .SetLabel("Permissions")
    .AddOption(1, "Read", true)
    .AddOption(2, "Write", false)
    .AddOption(4, "Execute", true)
    .Render())
