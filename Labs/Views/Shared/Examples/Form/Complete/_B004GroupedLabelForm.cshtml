@using DMBBootstrapBuilder
@using DMBFormBuilder
@using DMBPageBuilder
@model DMBFormBuilderLabs.Models.FormBuilderCompleteExampleModel

@using (Html.FormBuilder()
    .SetAction(Url.Action("ExamplesGrouped", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Complete grouped label form")
    .Begin())
{
    @Html.AntiForgeryToken()

    @using (Html.RowBuilder().SetGap(Gap.G3).Begin())
    {
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Lg).Begin())
        {
            @Html.TextFieldBuilderFor(m => m.FirstName).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-person")).SetGroupIcon("bi bi-person").Render()
            @Html.EmailFieldBuilderFor(m => m.Email).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-envelope-at")).SetGroupIcon("bi bi-envelope-at").Render()
            @Html.PasswordFieldBuilderFor(m => m.Password).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-key")).Render()
            @Html.TokenFieldBuilderFor(m => m.ApiToken).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-fingerprint")).Render()
            @Html.EnumSelectFieldBuilderFor(m => m.Priority).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-flag")).SetGroupIcon("bi bi-flag").Render()
            @Html.EnumRadioFieldBuilderFor(m => m.Visibility).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-ui-radios")).Render()
            @Html.FlagCheckboxFieldBuilderFor(m => m.Permissions).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-list-check")).Render()
            @Html.ColorFieldBuilderFor(m => m.Color).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-palette")).SetGroupIcon("bi bi-palette").Render()
            @Html.SliderFieldBuilderFor(m => m.Completion).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-sliders")).SetGroupIcon("bi bi-sliders").Render()
        }
        @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Lg).Begin())
        {
            @Html.DateFieldBuilderFor(m => m.DueDate).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-calendar-event")).SetGroupIcon("bi bi-calendar-event").Render()
            @Html.DateTimeFieldBuilderFor(m => m.DueDateTime).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-calendar2-week")).SetGroupIcon("bi bi-calendar2-week").Render()
            @Html.TimeFieldBuilderFor(m => m.ReminderTime).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-clock")).SetGroupIcon("bi bi-clock").Render()
            @Html.CountryFieldBuilderFor(m => m.Country).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-globe2")).SetGroupIcon("bi bi-globe2").Render()
            @Html.TextAreaFieldBuilderFor(m => m.Message).SetRows(4).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-chat-left-text")).Render()
            @Html.CheckboxFieldBuilderFor(m => m.AcceptTerms).SetMustBeChecked().SetLabelIcon(IconStruct.Bootstrap("bi-check2-square")).Render()
            @Html.CaptchaBuilderFor(m => m.CaptchaValue).SetLabelPresentation(FormLabelPresentation.Group).SetLabelIcon(IconStruct.Bootstrap("bi-shield-check")).SetPlaceholder("Captcha").Render()
        }
    }

    <button class="btn btn-primary" type="submit">Submit</button>
}
