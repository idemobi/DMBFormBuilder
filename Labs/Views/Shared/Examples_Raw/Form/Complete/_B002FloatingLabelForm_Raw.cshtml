<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBFormBuilder
@@using DMBPageBuilder
@@model DMBFormBuilderLabs.Models.FormBuilderCompleteExampleModel

@@using (Html.FormBuilder()
    .SetAction(Url.Action("ExamplesFloating", "FormBuilder"))
    .SetValidationMode(FormValidationMode.ClientAndServer)
    .DisableBrowserValidation()
    .SetAriaLabel("Complete floating label form")
    .Begin())
{
    @@Html.AntiForgeryToken()

    @@using (Html.RowBuilder().SetGap(Gap.G3).Begin())
    {
        @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Lg).Begin())
        {
            @@Html.TextFieldBuilderFor(m =&gt; m.FirstName).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-person")).Render()
            @@Html.EmailFieldBuilderFor(m =&gt; m.Email).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-envelope-at")).Render()
            @@Html.PasswordFieldBuilderFor(m =&gt; m.Password).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-key")).Render()
            @@Html.TokenFieldBuilderFor(m =&gt; m.ApiToken).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-fingerprint")).Render()
            @@Html.EnumSelectFieldBuilderFor(m =&gt; m.Priority).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-flag")).Render()
            @@Html.EnumRadioFieldBuilderFor(m =&gt; m.Visibility).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-ui-radios")).Render()
            @@Html.FlagCheckboxFieldBuilderFor(m =&gt; m.Permissions).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-list-check")).Render()
            @@Html.ColorFieldBuilderFor(m =&gt; m.Color).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-palette")).Render()
            @@Html.SliderFieldBuilderFor(m =&gt; m.Completion).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-sliders")).Render()
        }
        @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Lg).Begin())
        {
            @@Html.DateFieldBuilderFor(m =&gt; m.DueDate).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-calendar-event")).Render()
            @@Html.DateTimeFieldBuilderFor(m =&gt; m.DueDateTime).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-calendar2-week")).Render()
            @@Html.TimeFieldBuilderFor(m =&gt; m.ReminderTime).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-clock")).Render()
            @@Html.CountryFieldBuilderFor(m =&gt; m.Country).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-globe2")).Render()
            @@Html.TextAreaFieldBuilderFor(m =&gt; m.Message).SetRows(4).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-chat-left-text")).Render()
            @@Html.CheckboxFieldBuilderFor(m =&gt; m.AcceptTerms).SetMustBeChecked().SetLabelIcon(IconStruct.Bootstrap("bi-check2-square")).Render()
            @@Html.CaptchaBuilderFor(m =&gt; m.CaptchaValue).SetLabelPresentation(FormLabelPresentation.Floating).SetLabelIcon(IconStruct.Bootstrap("bi-shield-check")).SetPlaceholder("Captcha").Render()
        }
    }

    &lt;button class="btn btn-primary" type="submit"&gt;Submit&lt;/button&gt;
}</code></pre></div>