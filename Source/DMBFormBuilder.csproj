<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>DMBFormBuilder</RootNamespace>
        <Title>DMBFormBuilder</Title>
        <PackageTags>idemobi DMB PageBuilder Bootstrap Forms Validation Razor MVC Captcha</PackageTags>
        <Description>Bootstrap-oriented form and field builder package for MVC/Razor applications and PageBuilder views.</Description>
        <PackageReleaseNotes>note</PackageReleaseNotes>
        <PackageIcon>DMBFormBuilder.png</PackageIcon>
        <AssemblyOriginatorKeyFile>DMBFormBuilder.snk</AssemblyOriginatorKeyFile>
        <PackageId>DMBFormBuilder</PackageId>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <IncludeRazorContentInPack>false</IncludeRazorContentInPack>
        <EmbedRazorGenerateSources>false</EmbedRazorGenerateSources>
        <LangVersion>default</LangVersion>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <RunAnalyzers>true</RunAnalyzers>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SignAssembly>true</SignAssembly>
        <PublicSign>true</PublicSign>
        <Configurations>Debug;Release;NuGet</Configurations>
        <Platforms>AnyCPU</Platforms>
        <VersionBase>$([System.DateTime]::UtcNow.ToString("yyyy.Mdd.HHmm"))</VersionBase>
        <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
        <Version>0.19.0</Version>
        <FileVersion>0.19.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <Company>idéMobi</Company>
        <Authors>Jean-François CONTART, Quentin BOULOGNE, Camille GOLLIOT</Authors>
        <Copyright>Copyright © $(Company) $([System.DateTime]::UtcNow.ToString("yyyy"))</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageProjectUrl>https://dev.azure.com/ideMobi/DMBFormBuilder/_git/DMBFormBuilder</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>git@ssh.dev.azure.com:v3/ideMobi/DMBFormBuilder/DMBFormBuilder</RepositoryUrl>
        <RepositoryType>AzureDevOps</RepositoryType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyMetadataAttribute>true</GenerateAssemblyMetadataAttribute>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants/>
        <DocumentationFile>bin\Release\net10.0\DMBFormBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\net10.0\DMBFormBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'NuGet' ">
        <DefineConstants>NUGET</DefineConstants>
        <Optimize>true</Optimize>
        <DocumentationFile>bin\NuGet\net10.0\DMBFormBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <Choose>
        <When Condition=" '$(Configuration)' == 'NuGet' ">
            <ItemGroup Label="Case NuGet">
                <PackageReference Include="DMBPageBuilder" Version="0.19.0"/>
                <PackageReference Include="DMBBootstrapBuilder" Version="0.19.0"/>
                <PackageReference Include="DMBServerWebHelper" Version="0.19.0"/>
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup Label="Case Debug, Release, Deployment">
                <ProjectReference Include="..\..\DMBPageBuilder\Source\DMBPageBuilder.csproj"/>
                <ProjectReference Include="..\..\DMBBootstrapBuilder\Source\DMBBootstrapBuilder.csproj"/>
                <ProjectReference Include="..\..\DMBServerWebHelper\Source\DMBServerWebHelper.csproj"/>
            </ItemGroup>
        </Otherwise>
    </Choose>
    <ItemGroup Label="Import package">
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.8" />
    </ItemGroup>
    <ItemGroup Label="Files in package">
        <None Include="README.md" Pack="true" PackagePath="\"/>
        <None Include="LICENSE.md" Pack="true" PackagePath="\"/>
        <None Include="DMBFormBuilder.png" Pack="true" PackagePath="\"/>
        <None Remove="**/*.meta"/>
    </ItemGroup>
    <ItemGroup Condition=" '$(Configuration)' == 'Debug' " Label="Razor Generator">
        <Content Update="Views\*">
            <Generator>RazorGenerator</Generator>
        </Content>
    </ItemGroup>
    <ItemGroup Label="EmbeddedResource">
        <Content Remove="wwwroot\**\*"/>
        <EmbeddedResource Include="wwwroot\**\*"/>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.en-US.resx">
            <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.fr-FR.resx">
            <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.en-US.resx">
            <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.fr-FR.resx">
            <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBFormBuilderDataAnnotationLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBFormBuilderInternalLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <Compile Update="Resources\DMBFormBuilderDataAnnotationLocalization.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\DMBFormBuilderInternalLocalization.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.de-DE.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.es-ES.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.it-IT.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.ja-JP.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.ko-KR.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.nl-NL.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.pt-BR.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.tlh.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderDataAnnotationLocalization.zh-CN.resx">
          <DependentUpon>DMBFormBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.de-DE.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.es-ES.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.it-IT.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.ja-JP.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.ko-KR.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.nl-NL.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.pt-BR.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.tlh.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBFormBuilderInternalLocalization.zh-CN.resx">
          <DependentUpon>DMBFormBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Label="Project file exclusions">
        <None Remove=".gitignore" />
    </ItemGroup>
</Project>
